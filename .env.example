# Copiar a .env (ignorado por git) y rellenar con llaves reales.
# NUNCA commitear el .env real.

# Catálogo AUTODOC Parts Catalog (TecDoc) vía RapidAPI.
# OJO: cada consulta se paga del cupo mensual (20.000). No gastar sin decirlo.
RAPIDAPI_KEY=

# Ofertas de compra en eBay (hoy el pipeline funciona en modo mock sin estas llaves).
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_CAMPAIGN_ID=
# Opcional: identifica de dónde vino el clic (EPN lo llama "custom id" /
# "reference id"). Sirve para saber qué parte de la web trae las ventas.
EBAY_REFERENCE_ID=
